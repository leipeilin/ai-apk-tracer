{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-apk-tracer.local/schemas/run_manifest.schema.json",
  "title": "Run manifest",
  "type": "object",
  "required": ["schema_version", "run_id", "created_at", "status", "stage", "apk", "stages", "cleanup_history"],
  "properties": {
    "schema_version": {"enum": ["1.0.0", "2.0.0"]},
    "pipeline_version": {"type": "string"},
    "artifact_schema_versions": {
      "type": "object",
      "additionalProperties": {"type": "string"}
    },
    "run_id": {"type": "string", "pattern": "^[0-9]{8}T[0-9]{6}Z_[0-9a-f]{12}_[0-9a-f]{8}$"},
    "trace_id": {"type": "string"},
    "status": {"enum": ["queued", "running", "completed", "failed"]},
    "stage": {"type": "string"},
    "apk": {
      "type": "object",
      "required": ["sha256"],
      "properties": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
    },
    "stages": {"type": "array"},
    "artifacts": {"type": "array"},
    "analysis_incomplete": {"type": "boolean"},
    "coverage_gaps": {"type": "array"},
    "stop_reason": {"type": ["string", "null"]},
    "cache_hit": {"type": ["boolean", "null"]},
    "prompt_version": {"type": ["string", "null"]},
    "cleanup_history": {"type": "array"}
  },
  "additionalProperties": true
}
