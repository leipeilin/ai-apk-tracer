{
  "$defs": {
    "ChainProposal": {
      "additionalProperties": false,
      "description": "从攻击面入口到 sink 的候选链（低信任建议，非正式 sources/sinks）。",
      "properties": {
        "call_tree_refs": {
          "description": "可选：支撑该链的 call_tree 产物相对路径",
          "items": {
            "maxLength": 1024,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 16,
          "title": "Call Tree Refs",
          "type": "array"
        },
        "confidence": {
          "description": "模型对本链成立度的置信度",
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "title": "Confidence",
          "type": "string"
        },
        "evidence_refs": {
          "description": "支撑本链的轻量证据引用（T2.6 回查后归一化）",
          "items": {
            "$ref": "#/$defs/ExplorerEvidenceRef"
          },
          "maxItems": 64,
          "title": "Evidence Refs",
          "type": "array"
        },
        "hops": {
          "description": "结构化逐跳路径；每跳须可对 call_sites 表回查",
          "items": {
            "$ref": "#/$defs/Hop"
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "Hops",
          "type": "array"
        },
        "hypothesis": {
          "description": "假设（非裁决）：是否倾向构成漏洞，评审 §4.1",
          "enum": [
            "likely",
            "possible",
            "unlikely"
          ],
          "title": "Hypothesis",
          "type": "string"
        },
        "impact_proposal": {
          "description": "影响面/攻击场景/漏洞类型描述（假设级，非结论）",
          "maxLength": 10000,
          "minLength": 1,
          "title": "Impact Proposal",
          "type": "string"
        },
        "needs_expansion": {
          "default": false,
          "description": "本链是否需进一步扩片取证",
          "title": "Needs Expansion",
          "type": "boolean"
        },
        "reasoning": {
          "description": "构造本链的依据",
          "maxLength": 10000,
          "minLength": 1,
          "title": "Reasoning",
          "type": "string"
        },
        "sink": {
          "description": "候选 sink 方法/操作",
          "maxLength": 256,
          "minLength": 1,
          "title": "Sink",
          "type": "string"
        },
        "source": {
          "description": "候选 source 表达式/方法",
          "maxLength": 256,
          "minLength": 1,
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "source",
        "sink",
        "hops",
        "confidence",
        "hypothesis",
        "impact_proposal",
        "reasoning"
      ],
      "title": "ChainProposal",
      "type": "object"
    },
    "ComponentSummary": {
      "additionalProperties": false,
      "description": "对当前入口组件/代码的功能描述。",
      "properties": {
        "component": {
          "description": "组件类名",
          "maxLength": 256,
          "minLength": 1,
          "title": "Component",
          "type": "string"
        },
        "exported": {
          "description": "是否导出（可从外部触发）",
          "title": "Exported",
          "type": "boolean"
        },
        "kind": {
          "description": "组件类型",
          "enum": [
            "activity",
            "service",
            "provider",
            "receiver",
            "other"
          ],
          "title": "Kind",
          "type": "string"
        },
        "summary": {
          "description": "组件/代码功能描述",
          "maxLength": 10000,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "component",
        "kind",
        "exported",
        "summary"
      ],
      "title": "ComponentSummary",
      "type": "object"
    },
    "ExplorerEvidenceRef": {
      "additionalProperties": false,
      "description": "探索轨轻量证据引用（低信任）：仅指向可回查的源码位置。\n\n不复用 EvidenceReference（其 context_id/claim 必填，属确定性语义 bundle 的输入上下文\n引用）；探索轨证据由 T2.6 三档校验回查通过后归一化为正式证据。",
      "properties": {
        "claim": {
          "anyOf": [
            {
              "maxLength": 10000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "可选：该引用支撑的主张（供人工视图；校验后补全）",
          "title": "Claim"
        },
        "end_line": {
          "anyOf": [
            {
              "maximum": 10000000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "证据结束行；缺省表示单行",
          "title": "End Line"
        },
        "line": {
          "anyOf": [
            {
              "maximum": 10000000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "证据起始行",
          "title": "Line"
        },
        "path": {
          "description": "证据所在工作区相对路径（必填，可回查）",
          "maxLength": 1024,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "path"
      ],
      "title": "ExplorerEvidenceRef",
      "type": "object"
    },
    "ExplorerLoopState": {
      "additionalProperties": false,
      "description": "探索循环轮末状态（评审 §4.3：终止由代码判定，模型只声明意图）。",
      "properties": {
        "done": {
          "description": "是否已形成完整 sink 链、可结束循环",
          "title": "Done",
          "type": "boolean"
        },
        "reason": {
          "description": "结束或继续的原因说明（必填，便于审计）",
          "maxLength": 256,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "done",
        "reason"
      ],
      "title": "ExplorerLoopState",
      "type": "object"
    },
    "Hop": {
      "additionalProperties": false,
      "description": "数据流链上的一跳（结构化路径，评审 §4.2）。",
      "properties": {
        "arg_positions": {
          "description": "攻击者可控参数位置（从 0 起，非负）",
          "items": {
            "minimum": 0,
            "type": "integer"
          },
          "maxItems": 32,
          "title": "Arg Positions",
          "type": "array"
        },
        "call_site_line": {
          "description": "调用点源码行号",
          "maximum": 10000000,
          "minimum": 1,
          "title": "Call Site Line",
          "type": "integer"
        },
        "from_method_id": {
          "description": "源方法 ID 建议（path#Class.method:line；可回查性由 T2.6 校验）",
          "maxLength": 512,
          "minLength": 1,
          "title": "From Method Id",
          "type": "string"
        },
        "resolved_via": {
          "description": "调用解析方式",
          "enum": [
            "direct_call",
            "virtual_call",
            "dynamic_invoke",
            "binder_transaction",
            "other"
          ],
          "title": "Resolved Via",
          "type": "string"
        },
        "to_method_id": {
          "description": "目标方法 ID 建议",
          "maxLength": 512,
          "minLength": 1,
          "title": "To Method Id",
          "type": "string"
        }
      },
      "required": [
        "from_method_id",
        "to_method_id",
        "call_site_line",
        "resolved_via"
      ],
      "title": "Hop",
      "type": "object"
    },
    "ReadRequest": {
      "additionalProperties": false,
      "description": "探索循环中的结构化读码请求。\n\n仅暴露四种检索操作（评审 R-4 决策）：入口来自确定性 api_entry_table/attack_surface\n（属信任边界，不让 Agent 自由枚举入口）；class_hierarchy / resolve_invoke_target 为\ncall_tree 内部实现细节，不对模型暴露。",
      "properties": {
        "line": {
          "anyOf": [
            {
              "maximum": 10000000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "消歧用源码行号",
          "title": "Line"
        },
        "operation": {
          "description": "call_tree 服务可执行操作",
          "enum": [
            "get_method_body",
            "get_callees",
            "get_callers",
            "search_symbol"
          ],
          "title": "Operation",
          "type": "string"
        },
        "path": {
          "anyOf": [
            {
              "maxLength": 1024,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "消歧用工作区相对路径",
          "title": "Path"
        },
        "reason": {
          "description": "为什么需要这份代码/调用关系",
          "maxLength": 10000,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "target": {
          "description": "目标符号/方法/类名",
          "maxLength": 256,
          "minLength": 1,
          "title": "Target",
          "type": "string"
        }
      },
      "required": [
        "operation",
        "target",
        "reason"
      ],
      "title": "ReadRequest",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "探索 Agent（Agent1）单轮输出：低信任建议链 + 读码请求（方案 §2.4）。",
  "properties": {
    "chain_proposals": {
      "description": "本轮的候选链（低信任）",
      "items": {
        "$ref": "#/$defs/ChainProposal"
      },
      "maxItems": 8,
      "title": "Chain Proposals",
      "type": "array"
    },
    "component_summary": {
      "$ref": "#/$defs/ComponentSummary",
      "description": "组件/代码功能描述（每轮绑定一个入口组件，attack_surface 保证可总结，故必填）"
    },
    "loop": {
      "$ref": "#/$defs/ExplorerLoopState",
      "description": "循环状态"
    },
    "read_requests": {
      "description": "本轮的读码请求",
      "items": {
        "$ref": "#/$defs/ReadRequest"
      },
      "maxItems": 8,
      "title": "Read Requests",
      "type": "array"
    }
  },
  "required": [
    "component_summary",
    "loop"
  ],
  "title": "ExplorerObservation",
  "type": "object"
}
