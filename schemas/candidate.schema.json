{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-apk-tracer.local/schemas/candidate.schema.json",
  "title": "Rule candidate",
  "type": "object",
  "required": ["rule_id", "rule_version", "component", "severity_hint", "confidence_tier", "evidence_level", "locations", "sources", "sinks", "blocking_gaps"],
  "properties": {
    "pipeline_version": {"type": "string"},
    "schema_version": {"type": "string"},
    "rule_id": {"type": "string", "pattern": "^[A-Z0-9_]+$"},
    "rule_version": {"type": "string"},
    "component": {"enum": ["activity", "service", "provider", "receiver"]},
    "severity_hint": {"enum": ["critical", "high", "medium", "low", "informational", "pending"]},
    "confidence_tier": {"enum": ["low", "medium", "high"]},
    "evidence_level": {"enum": ["L1", "L2"]},
    "reachability_status": {"enum": ["reachable", "conditional", "unknown"]},
    "dataflow_status": {"type": "string"},
    "chain_id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._:-]+$"},
    "entry_method_id": {"type": ["string", "null"], "minLength": 1, "maxLength": 2048},
    "path_model": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z0-9][a-z0-9_.-]*$"},
    "flow_kind": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z0-9][a-z0-9_.-]*$"},
    "chains": false,
    "guard_status": {"enum": ["absent", "present_effective", "present_partial", "present_bypassable", "unknown"]},
    "authorization_status": {"enum": ["unprotected", "conditional", "protected", "strongly_protected", "unknown"]},
    "impact_status": {"type": "string"},
    "funnel_disposition": {"type": "string"},
    "analysis_status": {"type": "string"},
    "triage_disposition": {"enum": ["potential_chain", "exposure_only", "insufficient"]},
    "evidence_decision": {"type": "string"},
    "review_status": {"type": "string"},
    "review_state": {"type": "object"},
    "status_layers": {"type": "object"},
    "ai_stop_reason": {"type": ["string", "null"]},
    "cache_hit": {"type": ["boolean", "null"]},
    "prompt_version": {"type": ["string", "null"]},
    "ai_schema_version": {"type": ["string", "null"]},
    "authorization_matrix": {"type": "array", "items": {"type": "object"}},
    "guard_coverage": {"type": "object"},
    "locations": {"type": "array", "items": {"type": "object"}},
    "sources": {"type": "array"},
    "sinks": {"type": "array"},
    "blocking_gaps": {"type": "array"},
    "auxiliary": {"type": "boolean"}
  },
  "additionalProperties": true
}
