{
  "$defs": {
    "ExplorerEvidenceRef": {
      "additionalProperties": false,
      "description": "探索轨轻量证据引用（低信任）：仅指向可回查的源码位置。\n\n不复用 EvidenceReference（其 context_id/claim 必填，属确定性语义 bundle 的输入上下文\n引用）；探索轨证据由 T2.6 三档校验回查通过后归一化为正式证据。",
      "properties": {
        "claim": {
          "anyOf": [
            {
              "maxLength": 10000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "可选：该引用支撑的主张（供人工视图；校验后补全）",
          "title": "Claim"
        },
        "end_line": {
          "anyOf": [
            {
              "maximum": 10000000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "证据结束行；缺省表示单行",
          "title": "End Line"
        },
        "line": {
          "anyOf": [
            {
              "maximum": 10000000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "证据起始行",
          "title": "Line"
        },
        "path": {
          "description": "证据所在工作区相对路径（必填，可回查）",
          "maxLength": 1024,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "path"
      ],
      "title": "ExplorerEvidenceRef",
      "type": "object"
    },
    "Hop": {
      "additionalProperties": false,
      "description": "数据流链上的一跳（结构化路径，评审 §4.2）。",
      "properties": {
        "arg_positions": {
          "description": "攻击者可控参数位置（从 0 起，非负）",
          "items": {
            "minimum": 0,
            "type": "integer"
          },
          "maxItems": 32,
          "title": "Arg Positions",
          "type": "array"
        },
        "call_site_line": {
          "description": "调用点源码行号",
          "maximum": 10000000,
          "minimum": 1,
          "title": "Call Site Line",
          "type": "integer"
        },
        "from_method_id": {
          "description": "源方法 ID 建议（path#Class.method:line；可回查性由 T2.6 校验）",
          "maxLength": 512,
          "minLength": 1,
          "title": "From Method Id",
          "type": "string"
        },
        "resolved_via": {
          "description": "调用解析方式",
          "enum": [
            "direct_call",
            "virtual_call",
            "dynamic_invoke",
            "binder_transaction",
            "other"
          ],
          "title": "Resolved Via",
          "type": "string"
        },
        "to_method_id": {
          "description": "目标方法 ID 建议",
          "maxLength": 512,
          "minLength": 1,
          "title": "To Method Id",
          "type": "string"
        }
      },
      "required": [
        "from_method_id",
        "to_method_id",
        "call_site_line",
        "resolved_via"
      ],
      "title": "Hop",
      "type": "object"
    },
    "VerifyChainFacts": {
      "additionalProperties": false,
      "description": "盲验链事实（剥离版 ChainProposal：仅可回查事实层，不含假设字段；T0.9 评审 R-1）。\n\n构造层（T2.11）从 ExplorerCandidate.chain_proposal 投影，剥离\nconfidence/hypothesis/impact_proposal/reasoning/needs_expansion。",
      "properties": {
        "call_tree_refs": {
          "description": "可选：支撑该链的 call_tree 产物相对路径",
          "items": {
            "maxLength": 1024,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 16,
          "title": "Call Tree Refs",
          "type": "array"
        },
        "evidence_refs": {
          "description": "链上轻量证据引用",
          "items": {
            "$ref": "#/$defs/ExplorerEvidenceRef"
          },
          "maxItems": 64,
          "title": "Evidence Refs",
          "type": "array"
        },
        "hops": {
          "description": "结构化逐跳路径（纯事实，Hop 无假设字段）",
          "items": {
            "$ref": "#/$defs/Hop"
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "Hops",
          "type": "array"
        },
        "sink": {
          "description": "候选 sink 方法/操作",
          "maxLength": 256,
          "minLength": 1,
          "title": "Sink",
          "type": "string"
        },
        "source": {
          "description": "候选 source 表达式/方法",
          "maxLength": 256,
          "minLength": 1,
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "source",
        "sink",
        "hops"
      ],
      "title": "VerifyChainFacts",
      "type": "object"
    },
    "VerifyClaim": {
      "additionalProperties": false,
      "description": "待证命题（确定性代码从候选 facts/Guard/hops 生成，不含提出者假设）。",
      "properties": {
        "index": {
          "description": "命题索引（从 0 起，输出按此对应）",
          "minimum": 0,
          "title": "Index",
          "type": "integer"
        },
        "kind": {
          "description": "命题类型",
          "enum": [
            "entry_reachable",
            "propagation",
            "guard_effective",
            "authorization",
            "sink_behavior",
            "source_controllability",
            "other"
          ],
          "title": "Kind",
          "type": "string"
        },
        "statement": {
          "description": "命题陈述（如“入口 X 的参数在无 Guard 下传播到 sink Y”）",
          "maxLength": 10000,
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        }
      },
      "required": [
        "index",
        "statement",
        "kind"
      ],
      "title": "VerifyClaim",
      "type": "object"
    },
    "VerifyFact": {
      "additionalProperties": false,
      "description": "确定性事实（结构化，杜绝假设层文本混入；T0.9 评审 R-3）。",
      "properties": {
        "fact_type": {
          "description": "事实类型",
          "enum": [
            "source",
            "sink",
            "guard",
            "authorization",
            "component",
            "reachability",
            "other"
          ],
          "title": "Fact Type",
          "type": "string"
        },
        "statement": {
          "description": "事实陈述（不含 severity/confidence/hypothesis 等假设语义）",
          "maxLength": 10000,
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        }
      },
      "required": [
        "fact_type",
        "statement"
      ],
      "title": "VerifyFact",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "核验输入（盲验：结构上不含假设层字段——顶层与嵌套均无；T0.9 评审 R-1/R-3）。",
  "properties": {
    "candidate_id": {
      "description": "被核验候选的稳定 ID",
      "maxLength": 160,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/#@+\\-]*$",
      "title": "Candidate Id",
      "type": "string"
    },
    "chain_facts": {
      "anyOf": [
        {
          "$ref": "#/$defs/VerifyChainFacts"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "可选：探索候选的剥离版链事实（无假设字段）"
    },
    "claims": {
      "description": "待证命题清单",
      "items": {
        "$ref": "#/$defs/VerifyClaim"
      },
      "maxItems": 32,
      "minItems": 1,
      "title": "Claims",
      "type": "array"
    },
    "code_context": {
      "anyOf": [
        {
          "maxLength": 10000,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "可选：已取回的相关代码片段文本",
      "title": "Code Context"
    },
    "deterministic_facts": {
      "description": "候选确定性事实（结构化；构造层剥离假设语义）",
      "items": {
        "$ref": "#/$defs/VerifyFact"
      },
      "maxItems": 64,
      "title": "Deterministic Facts",
      "type": "array"
    },
    "evidence_refs": {
      "description": "已确认可回查的既有证据",
      "items": {
        "$ref": "#/$defs/ExplorerEvidenceRef"
      },
      "maxItems": 64,
      "title": "Evidence Refs",
      "type": "array"
    }
  },
  "required": [
    "candidate_id",
    "claims"
  ],
  "title": "VerifyInput",
  "type": "object"
}
